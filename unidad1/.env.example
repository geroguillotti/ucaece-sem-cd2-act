# Copiar este archivo a ".env" y completar con tus propios valores.
# El archivo ".env" nunca se sube al repositorio (ver .gitignore).

# Proveedor de inferencia a usar: "groq" o "gemini"
MODEL_PROVIDER=groq

# API key gratuita de Groq (console.groq.com) - requerida solo si MODEL_PROVIDER=groq
GROQ_API_KEY=

# Opcional: id del modelo de Groq. Si se omite se usa llama-3.3-70b-versatile.
# GROQ_MODEL_NAME=llama-3.3-70b-versatile

# API key gratuita de Google AI Studio (Gemini API) - requerida solo si MODEL_PROVIDER=gemini
GEMINI_API_KEY=
